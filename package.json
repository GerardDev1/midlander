{
  "name": "midlander",
  "version": "0.0.1",
  "private": true,
  "description": "Midlander: a desktop screenwriting application",
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\" \"app/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "compare": "node tools/compare-layout.ts",
    "app:dev": "npm run dev -w @midlander/app",
    "app:build": "npm run build -w @midlander/app",
    "test:e2e": "node --test --test-concurrency=1 \"app/e2e/*.e2e.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
